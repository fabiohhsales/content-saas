{
  "name": "@content-saas/render",
  "version": "0.1.0",
  "private": true,
  "description": "HTML/CSS to PNG/JPG render service using Playwright",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node -e \"require('fs').cpSync('templates-html','dist-test/templates-html',{recursive:true})\" && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@content-saas/contracts": "*",
    "express": "^4.18.2",
    "playwright": "^1.44.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
